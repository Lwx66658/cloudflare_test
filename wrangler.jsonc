{
  "name": "cloudflare-test",
  "main": "./build/worker.mjs",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-test-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
